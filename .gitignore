# Python: кеш и скомпилированные файлы
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Виртуальные окружения
.venv/
venv/
env/

# Системные файлы macOS
.DS_Store

# Предобученные и обученные веса моделей
*.pt
*.pth

# Результаты запусков экспериментов остаются локально
runs/*
!runs/.gitkeep

# Переменные окружения и секреты
.env
.env.*
!.env.example

# Настройки редакторов кода
.vscode/
.idea/

# Кеши разметки Ultralytics
*.cache

# Логи TensorBoard игнорируются по умолчанию
events.out.tfevents*

# Но логи опубликованных экспериментов разрешены
!reports/experiments/**/events.out.tfevents*

# Подготовленные выборки (основная публикуется, пересобранная копия - нет)
data/processed_rebuilt/

# Визуализации исходной разметки (публикуется основная, пересобранная - нет)
reports/samples/visualizations_rebuilt/

# Временные отчеты и манифесты повторной проверки
reports/dataset_report_rebuilt.md
reports/manifest_rebuilt.sha256